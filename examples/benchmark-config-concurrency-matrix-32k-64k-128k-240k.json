{
  "version": 1,
  "name": "concurrency-matrix-32k-64k-128k-240k",
  "description": "随机长上下文并发矩阵：32K/2K、64K/4K、128K/8K 和 240K/16K。每档正式请求数为并发数两倍，目标共享前缀约占输入的 70%。所有用例默认启用；某一长度组失败时跳过该组剩余并发档位；运行前应复制为本地配置并确认成本。",
  "metadata": {
    "purpose": "long-context-concurrency-matrix",
    "workloads": [
      "32K input / 2K output",
      "64K input / 4K output",
      "128K input / 8K output",
      "240K input / 16K output"
    ],
    "shared_prefix_target": "70%",
    "requests_per_case": "2 × concurrency"
  },
  "continue_on_error": true,
  "failure_policy": "stop-current-matrix",
  "defaults": {
    "mode": "api",
    "api_base": "http://localhost:8000/v1",
    "model": "your-served-model",
    "tokenizer": "/path/to/model-or-tokenizer",
    "dataset": "random",
    "random_range_ratio": "0.0",
    "ignore_eos": true,
    "max_failure_rate": 1.0,
    "min_goodput_pct": 0.0,
    "warmup": {
      "enabled": false
    }
  },
  "report": {
    "path": "concurrency-matrix-32k-64k-128k-240k-report-{timestamp}.json",
    "include_request_details": false,
    "indent": 2
  },
