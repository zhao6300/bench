{
  "version": 1,
  "name": "pd-ratio-128k-2k",
  "description": "以平均 128K 输入、2K 输出的业务形状评估 Prefill/Decode（P/D）分离。该用例先在同一 API 服务上分别测量 Prefill 与 Decode 吞吐及延迟，再计算推荐的 P:D 实例比例和单实例调度参数；不会启动实际分离部署或测量 KV 传输、router 开销。默认禁用，复制为本地配置、完成服务参数设置并明确接受测试流量后再启用。",
  "metadata": {
    "purpose": "prefill-decode-disaggregation-sizing",
    "workload": "128K average input / 2K average output",
    "measurement": "single-instance prefill and decode throughput"
  },
  "continue_on_error": true,
  "defaults": {
    "mode": "api",
    "api_base": "http://localhost:8000/v1",
    "api_transport": "requests",
    "model": "your-served-model",
    "tokenizer": "your-tokenizer",
    "dataset": "random",
    "tokens": {
      "input": 131072,
      "output": 2048
    },
    "ignore_eos": true,
    "tp_size": 2,
    "slo": {
      "ttft_seconds": 60.0,
      "tpot_seconds": 0.05
    },
    "max_failure_rate": 0.0,
    "warmup": {
      "enabled": true,
      "rounds": 1,
      "requests_per_round": 1
    }
  },
  "report": {
    "path": "pd-ratio-128k-2k-report-{timestamp}.json",
    "include_request_details": false,
    "indent": 2
  },
  "cases": [
    {
      "name": "pd-ratio-128k-2k",
      "description": "测量 128K 平均输入、2K 平均输出的单实例 Prefill/Decode 吞吐与延迟，给出以 TP=2、总计 8 张 GPU 为约束的 P:D 部署比例建议。启用前请更新模型、tokenizer、服务地址、tp_size 和总 GPU 数。",
      "tags": ["pd", "sizing", "disaggregation", "input-128k", "output-2k", "expensive"],
      "enabled": false,
      "preset": "pd-ratio",
      "params": {
        "pd": {
          "avg_input_tokens": 131072,
          "avg_output_tokens": 2048,
          "total_gpus": 8
        }
      }
    }
  ]
}
