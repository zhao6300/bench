{
  "version": 1,
  "name": "ported-dataset-smoke-suite",
  "description": "校验 sonnet、sharegpt、burstgpt、hf、gsm8k 与 coding/work 本地数据集接入",
  "continue_on_error": true,
  "defaults": {
    "mode": "api",
    "api_base": "http://localhost:8000/v1",
    "api_transport": "requests",
    "model": "your-served-model",
    "tokenizer": "your-model-or-tokenizer",
    "seed": 42
  },
  "report": {
    "include_request_details": false
  },
  "cases": [
    {
      "name": "sonnet-sample",
      "tags": ["dataset", "sonnet"],
      "scenario": "single",
      "params": {
        "dataset": "sonnet",
        "dataset_path": "examples/datasets/sonnet.txt",
        "sonnet_input_len": 70,
        "sonnet_output_len": 4,
        "sonnet_prefix_len": 30,
        "requests": {"concurrency": 1, "count": 2}
      }
    },
    {
      "name": "sharegpt-sample",
      "tags": ["dataset", "sharegpt"],
      "scenario": "single",
      "params": {
        "dataset": "sharegpt",
        "dataset_path": "examples/datasets/local-sharegpt.json",
        "requests": {"concurrency": 1, "count": 1}
      }
    },
    {
      "name": "burstgpt-sample",
      "tags": ["dataset", "burstgpt"],
      "scenario": "single",
      "params": {
        "dataset": "burstgpt",
        "dataset_path": "examples/datasets/burstgpt.csv",
        "requests": {"concurrency": 1, "count": 2}
      }
    },
    {
      "name": "hf-sample",
      "tags": ["dataset", "hf"],
      "scenario": "single",
      "params": {
        "dataset": "hf",
        "dataset_path": "examples/datasets/local-hf.jsonl",
        "hf_output_len": 1,
        "requests": {"concurrency": 1, "count": 1}
      }
    },
    {
      "name": "gsm8k-sample",
      "tags": ["dataset", "gsm8k", "speculative-decoding"],
      "scenario": "single",
      "params": {
        "dataset": "gsm8k",
        "dataset_path": "examples/datasets/gsm8k/openai-gsm8k-test.jsonl",
        "gsm8k_input_len": 256,
        "gsm8k_output_len": 64,
        "gsm8k_round_prefix_len": 32,
        "requests": {"concurrency": 1, "count": 2}
      }
    },
    {
      "name": "humaneval-sample",
      "tags": ["dataset", "humaneval", "coding"],
      "scenario": "single",
      "enabled": false,
      "params": {
        "dataset": "humaneval",
        "dataset_path": "examples/datasets/coding-work/openai-humaneval-test.jsonl",
        "dataset_output_len": 8,
        "requests": {"concurrency": 1, "count": 1}
      }
    },
    {
      "name": "instructcoder-sample",
      "tags": ["dataset", "instructcoder", "coding"],
      "scenario": "single",
      "enabled": false,
      "params": {
        "dataset": "instructcoder",
        "dataset_path": "examples/datasets/coding-work/likaixin-instructcoder-validation.jsonl",
        "dataset_output_len": 8,
        "requests": {"concurrency": 1, "count": 1}
      }
    },
    {
      "name": "blazedit-sample",
      "tags": ["dataset", "blazedit", "coding"],
      "scenario": "single",
      "enabled": false,
      "params": {
        "dataset": "blazedit",
        "dataset_path": "examples/datasets/coding-work/blazedit-5k-char-train.jsonl",
        "dataset_output_len": 8,
        "requests": {"concurrency": 1, "count": 1}
      }
    },
    {
      "name": "bfcl-sample",
      "tags": ["dataset", "bfcl", "work"],
      "scenario": "single",
      "enabled": false,
      "params": {
        "dataset": "bfcl",
        "dataset_path": "examples/datasets/coding-work/bfcl-v3-simple-live_simple-multiple.jsonl",
        "dataset_output_len": 8,
        "requests": {"concurrency": 1, "count": 1}
      }
    }
  ]
}
